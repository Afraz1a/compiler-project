// ===================================================================
//  ex2_primes.citu  --  print every prime below a limit
//
//  Shows: nested jabtak loops, the % operator, nikal inside the inner
//         loop only, the word operators aur / ya / nahi, block scope
//         (the inner `d` and `prime` live in the loop body block),
//         and several unsigned / sized integer types.
// ===================================================================

uint16 limit melado 40;
uint16 n melado 2;
uint16 count melado 0;
uint32 total melado 0;          // sum of the primes found

jabtak ( n < limit ) shuro

    // these two belong to the loop body block, not to the program
    uint16 d melado 2;
    int16 prime melado 1;

    jabtak ( d * d <= n ) shuro
        agar ( n % d = 0 ) shuro
            prime melado 0;
            nikal;              // no need to try any more divisors
        khatam
        d melado d + 1;
    khatam

    agar ( prime = 1 aur nahi (n = 1) ) shuro
        dikhao(n, " is prime");
        count melado count + 1;
        total melado total + n;
    khatam

    n melado n + 1;
khatam

dikhao("primes below ", limit, ": ", count);
dikhao("their sum: ", total);
