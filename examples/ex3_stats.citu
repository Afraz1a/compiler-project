// ===================================================================
//  ex3_stats.citu  --  minimum, maximum and mean of a data set
//
//  Shows: every declarable Citu type (char, int16, uint16, int32,
//         uint32, real), mixed-type arithmetic with the automatic
//         widening the compiler inserts, real division, the ya
//         operator, a char literal, and a grade chosen with a chain
//         of agar / wagarna.
// ===================================================================

int32 count melado 10;
int16 marks[10];

marks[0] melado 72;
marks[1] melado 48;
marks[2] melado 91;
marks[3] melado 65;
marks[4] melado 33;
marks[5] melado 88;
marks[6] melado 57;
marks[7] melado 79;
marks[8] melado 95;
marks[9] melado 61;

int16  lowest  melado 32767;    // the largest value an int16 can hold
int16  highest melado -32768;
int32  sum     melado 0;
int32  passes  melado 0;
int32  k       melado 0;

jabtak ( k < count ) shuro
    agar ( marks[k] < lowest ) shuro
        lowest melado marks[k];
    khatam
    agar ( marks[k] > highest ) shuro
        highest melado marks[k];
    khatam
    sum melado sum + marks[k];
    agar ( marks[k] >= 50 ) shuro
        passes melado passes + 1;
    khatam
    k melado k + 1;
khatam

// integer sum divided by an integer count, in real arithmetic:
// the compiler widens both operands to real before dividing
real mean melado sum / 1.0 / count;

dikhao("count   : ", count);
dikhao("lowest  : ", lowest);
dikhao("highest : ", highest);
dikhao("sum     : ", sum);
dikhao("mean    : ", mean);
dikhao("passed  : ", passes, " of ", count);

// a grade for the class average
char grade melado 'F';
agar ( mean >= 80.0 ) shuro
    grade melado 'A';
khatam wagarna shuro
    agar ( mean >= 70.0 ) shuro
        grade melado 'B';
    khatam wagarna shuro
        agar ( mean >= 60.0 ya mean >= 55.0 ) shuro
            grade melado 'C';
        khatam
    khatam
khatam

dikhao("grade   : ", grade);
