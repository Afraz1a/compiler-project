// ===================================================================
//  ex4_errors.citu  --  NOT a working program.
//
//  Every line below contains a deliberate mistake.  It exists to show
//  that the compiler reports many errors in one run (it does not stop
//  at the first), that it names the phase and the exact line and
//  column, and that it recovers and keeps going.
//
//  Compile it with:   python cituc.py examples/ex4_errors.citu
// ===================================================================

int32 x melado 5;
int32 x melado 6;           // semantic: x is already declared

char  c melado 70000;       // semantic: literal does not fit in char

int32 arr[3];
arr[7] melado 1;            // semantic: index 7 is outside arr

agar ( x ) shuro            // semantic: condition is not a comparison
    dikhao(y);              // semantic: y is not declared
khatam

nikal;                      // semantic: nikal outside a jabtak loop

int32 q melado x / 0;       // semantic: division by zero
int32 w melado arr;         // semantic: an array needs a subscript

real r melado 2.5;
int32 z melado x % r;       // semantic: % needs integer operands

int32 m melado 3 @ 4;       // lexical: '@' is not a Citu character

int32 k melado ;            // syntax: expression missing
dikhao("unterminated       // lexical: string literal never closed
